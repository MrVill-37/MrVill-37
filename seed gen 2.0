"""Wallet activity auditor.

This script is intentionally defensive: it only checks public information
for addresses you provide and never attempts key recovery, brute force,
or unauthorized asset access.
"""

from __future__ import annotations

import argparse
import json
import os
import time
from dataclasses import dataclass, asdict
from datetime import datetime, timezone

import requests

ETHERSCAN_API = "https://api.etherscan.io/api"
DEFAULT_TIMEOUT = 15


@dataclass
class WalletReport:
    address: str
    wei_balance: int
    tx_count: int
    last_activity_utc: str | None
    inactive_days: int | None
    is_inactive: bool


class WalletAuditor:
    """Audit public wallet metadata for addresses you own or are authorized to monitor."""

    def __init__(self, api_key: str, min_interval_s: float = 0.3) -> None:
        self.api_key = api_key
        self.min_interval_s = min_interval_s
        self._last_request_at = 0.0

    def _throttle(self) -> None:
        elapsed = time.time() - self._last_request_at
        remaining = self.min_interval_s - elapsed
        if remaining > 0:
            time.sleep(remaining)

    def _call(self, params: dict) -> dict:
        self._throttle()
        params = {**params, "apikey": self.api_key}
        response = requests.get(ETHERSCAN_API, params=params, timeout=DEFAULT_TIMEOUT)
        self._last_request_at = time.time()
        response.raise_for_status()
        payload = response.json()
        status = payload.get("status")
        if status == "0" and payload.get("message") not in {"No transactions found", "No records found"}:
            raise RuntimeError(payload.get("result", "Unknown API error"))
        return payload

    def _balance(self, address: str) -> int:
        payload = self._call({
            "module": "account",
            "action": "balance",
            "address": address,
            "tag": "latest",
        })
        return int(payload["result"])

    def _txs(self, address: str) -> list[dict]:
        payload = self._call({
            "module": "account",
            "action": "txlist",
            "address": address,
            "startblock": 0,
            "endblock": 99999999,
            "page": 1,
            "offset": 1,
            "sort": "desc",
        })
        return payload.get("result", []) or []

    def report(self, address: str, inactivity_days: int) -> WalletReport:
        if not (address.startswith("0x") and len(address) == 42):
            raise ValueError(f"Invalid Ethereum address format: {address}")

        wei_balance = self._balance(address)
        txs = self._txs(address)
        tx_count = 0
        last_activity = None
        inactive_days = None

        if txs:
            tx_count = max(int(txs[0].get("nonce", 0)) + 1, len(txs))
            timestamp = int(txs[0]["timeStamp"])
            dt = datetime.fromtimestamp(timestamp, tz=timezone.utc)
            last_activity = dt.isoformat()
            inactive_days = (datetime.now(timezone.utc) - dt).days

        return WalletReport(
            address=address,
            wei_balance=wei_balance,
            tx_count=tx_count,
            last_activity_utc=last_activity,
            inactive_days=inactive_days,
            is_inactive=inactive_days is not None and inactive_days >= inactivity_days,
        )


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Audit public activity for Ethereum addresses you own/are authorized to monitor. "
            "No key recovery or asset retrieval is performed."
        )
    )
    parser.add_argument("addresses", nargs="+", help="One or more Ethereum addresses")
    parser.add_argument("--api-key", default=os.getenv("ETHERSCAN_API_KEY"), help="Etherscan API key")
    parser.add_argument("--inactive-days", type=int, default=90, help="Inactivity threshold in days")
    parser.add_argument("--output", default="wallet_audit.json", help="Output JSON file")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if not args.api_key:
        raise SystemExit("Missing API key. Set ETHERSCAN_API_KEY or pass --api-key.")

    auditor = WalletAuditor(api_key=args.api_key)
    reports: list[dict] = []

    for address in args.addresses:
        try:
            report = auditor.report(address, inactivity_days=args.inactive_days)
            reports.append(asdict(report))
            print(f"OK {address}: balance_wei={report.wei_balance} tx_count={report.tx_count}")
        except Exception as exc:
            reports.append({"address": address, "error": str(exc)})
            print(f"ERROR {address}: {exc}")

    with open(args.output, "w", encoding="utf-8") as fh:
        json.dump(reports, fh, indent=2)
    print(f"Wrote {len(reports)} records to {args.output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
